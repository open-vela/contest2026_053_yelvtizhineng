# Include inside your own HTTPS server{} block; issue/install certificates separately.
# Route BOX before the general API. Endpoints stay under the same public host.
location ^~ /api/v1/box/ {
    proxy_pass http://127.0.0.1:9012;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 120s;
}
location / {
    proxy_pass http://127.0.0.1:8011;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
}
