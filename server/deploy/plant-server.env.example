# Template only. Keep the filled /etc/plant-server.env outside Git.
PLANT_DATA_DIR=/opt/plant_server/data
PLANT_DB=/opt/plant_server/data/plant.db
PLANT_TOKEN_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
PLANT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PLANT_AI_MODE=auto
PLANT_MIMO_KEY=
PLANT_MIMO_MODEL=mimo-v2.6-flash
PLANT_MIMO_TEXT_MODEL=mimo-v2.6-pro
PLANT_TTS_MODEL=mimo-v2.5-tts
PLANT_TTS_VOICE=mimo_default
PLANT_TTS_SAMPLE_RATE=16000
PLANT_DEMO_OPEN=0
PLANT_DEMO_SMS_ECHO=0
PLANT_DEMO_CODE=CHANGE_ME_DEMO_CODE
PLANT_LEGACY_BRIDGE=0
PYTHONDONTWRITEBYTECODE=1
