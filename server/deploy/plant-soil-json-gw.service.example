[Unit]
Description=Plant Companion Standard Soil JSON MQTT Bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/plant_soil
EnvironmentFile=/opt/plant_soil/json_bridge.env
ExecStart=/opt/plant_soil/venv/bin/python /opt/plant_soil/mqtt_soil_gateway.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
