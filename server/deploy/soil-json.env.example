SOIL_MQTT_HOST=mqtt.example.com
SOIL_MQTT_PORT=8883
SOIL_MQTT_USER=CHANGE_ME_MQTT_USER
SOIL_MQTT_PASS=CHANGE_ME_MQTT_PASSWORD
SOIL_MQTT_TLS=1
SOIL_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
SOIL_MQTT_TOPIC=plant/+/sensor
SOIL_MQTT_CLIENT_ID=plant-soil-json-bridge
SOIL_MQTT_QOS=1
SOIL_API_URL=http://127.0.0.1:8011/api/v1/telemetry/put
SOIL_DEVICE_TOKENS={"d_000000000002":"CHANGE_ME_DEVICE_TOKEN"}
SOIL_QUEUE_PATH=/opt/plant_soil/data/mqtt_queue.jsonl
SOIL_API_TIMEOUT=10
SOIL_RETRY_SEC=10
