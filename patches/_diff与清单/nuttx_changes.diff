+/****************************************************************************
+ * Name: esp_semphr_delete
+ *
+ * Description:
+ *   Delete semaphore
+ *
+ * Input Parameters:
+ *   semphr - Semaphore data pointer
+ *
+ * Returned Value:
+ *   None
+ *
+ ****************************************************************************/
+
+static void esp_semphr_delete(void *semphr)
+{
+  sem_t *sem = (sem_t *)semphr;
+
+  nxsem_destroy(sem);
+  kmm_free(sem);
+}
