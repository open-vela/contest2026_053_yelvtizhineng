+  ret = file_mq_getattr(&mq_adpt->mq, &attr);
+  if (ret < 0)
+    {
+      wlerr("Failed to get attr from mqueue error=%d\n", ret);
+      return 0;
+    }
+
+  return attr.mq_curmsgs;
+}
