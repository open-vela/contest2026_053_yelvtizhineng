+/****************************************************************************
+ * Name: esp_wifi_int_disable
+ *
+ * Description:
+ *   Enter critical section by disabling interrupts and taking the spin lock
+ *   if in SMP mode.
+ *
+ * Input Parameters:
+ *   wifi_int_mux - Spin lock data pointer
+ *
+ * Returned Value:
+ *   CPU PS value.
+ *
+ ****************************************************************************/
+
+static uint32_t IRAM_ATTR esp_wifi_int_disable(void *wifi_int_mux)
+{
+  irqstate_t flags;
