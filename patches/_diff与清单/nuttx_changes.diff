diff --git a/arch/xtensa/src/esp32s3/esp32s3_wlan.c b/arch/xtensa/src/esp32s3/esp32s3_wlan.c
index d7c0578d..ade88b79 100644
--- a/arch/xtensa/src/esp32s3/esp32s3_wlan.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_wlan.c
@@ -520,26 +520,40 @@ static void wlan_transmit(struct wlan_priv_s *priv)
 {
   struct wlan_pktbuf *pktbuf;
   int ret;
+  int txfail = 0;
 
   while ((pktbuf = wlan_txframe(priv)))
     {
       ret = priv->ops->send(pktbuf->buffer, pktbuf->len);
-      if (ret == -ENOMEM)
+      if (ret < 0)
         {
-          wlan_add_txpkt_head(priv, pktbuf);
-          wd_start(&priv->txtimeout, WLAN_TXTOUT,
-                   wlan_txtimeout_expiry, (uint32_t)priv);
-          break;
+          /* [ZXB-TXRETRY] WiFi 刚关联后的一段时间内 esp_wifi_internal_tx
+           * 可能短暂返回错误（-EINVAL/-EIO 等）。直接丢包会让上层 TCP
+           * 认为数据已交驱动、等待 ACK 却永远等不到（无缓冲 TCP 的
+           * send() 会卡/报错）。这里与 -ENOMEM 同策略：插回队头，等
+           * WLAN_TXTOUT 后再试，连续 3 次仍失败才丢包（留给 TCP 重传
+           * 兜底），避免永久卡死。 */
+
+          if (++txfail < 4)
+            {
+              nwarn("WARN: TX retry %d (ret=%d)\n", txfail, ret);
+              wlan_add_txpkt_head(priv, pktbuf);
+              wd_start(&priv->txtimeout, WLAN_TXTOUT,
+                       wlan_txtimeout_expiry, (uint32_t)priv);
+              break;
+            }
+          else
+            {
+              nwarn("WARN: TX drop after retries (ret=%d)\n", ret);
+              txfail = 0;
+            }
         }
       else
         {
-          if (ret < 0)
-            {
-              nwarn("WARN: Failed to send pkt, ret: %d\n", ret);
-            }
-
-          wlan_free_buffer(priv, pktbuf->buffer);
+          txfail = 0;
         }
+
+      wlan_free_buffer(priv, pktbuf->buffer);
     }
 }
 
