 #define HAL_RX_PREFETCH_DEPTH  2    /* 预读在途 apb 深度（A/B 乒乓） */
 
 static int16_t s_rx_fifo[HAL_RX_FIFO_SAMPLES];    /* 环形缓冲（static 4KB） */
