-
-  tmp = sizeof(sem_t);
-  sem = kmm_malloc(tmp);
-  if (!sem)
-    {
-      wlerr("Failed to alloc %d memory\n", tmp);
-      return NULL;
-    }
-
-  ret = nxsem_init(sem, 0, init);
-  if (ret)
