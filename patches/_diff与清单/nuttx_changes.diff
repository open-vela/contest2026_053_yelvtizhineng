- * Returned Value:
- *   True if success or false if fail
- *
- ****************************************************************************/
-
-static int32_t esp_semphr_give(void *semphr)
-{
-  int ret;
-  sem_t *sem = (sem_t *)semphr;
-
-  ret = nxsem_post(sem);
-  if (ret)
-    {
-      wlerr("Failed to post sem error=%d\n", ret);
-    }
-
-  return osi_errno_trans(ret);
-}
