--- /dev/null
+++ b/arch/xtensa/src/esp32s3/hal_i2s_box_tdm.h
@@ -0,0 +1,28 @@
+#ifndef HAL_I2S_BOX_TDM_H
+#define HAL_I2S_BOX_TDM_H
+#include <stddef.h>
+#include <stdint.h>
+/* Two 32-bit standard I2S slots carry four 16-bit ES7210 TDM inputs.
+ * The DAC still consumes the first 16 MSBs of each output slot. */
+static inline void box_tdm_pack_output(uint32_t *dst,const int16_t *src,size_t samples)
+{for(size_t i=0;i<samples;i++)dst[i]=(uint32_t)(uint16_t)src[i]<<16;}
+static inline size_t box_tdm_frames(size_t dma_bytes){return dma_bytes/8;}
+static inline int16_t box_tdm_input(const int16_t *src,size_t frame,unsigned slot)
+{return src[4*frame+slot];}
+/* The standard-I2S receiver can present the two TDM words in either WS
+ * phase. Physical probing verified the electrical DAC return is in lane
+ * 0 or 2; the other is the powered-down fourth ADC. Neither is a mic.
+ * Follow a clearly active return at DMA boundaries, preserving its gain
+ * and every microphone/reference sample on the shared clock. */
+static inline unsigned box_tdm_reference_slot(const int16_t *src,size_t frames,unsigned slot)
+{
+  if(!frames || slot>3)return slot;
+  uint64_t energy[2]={0,0};
+  for(size_t i=0;i<frames;i++)for(unsigned ch=0;ch<2;ch++)
+    {int32_t v=box_tdm_input(src,i,ch*2+(slot&1u));energy[ch]+=(uint64_t)(v*v);}
+  unsigned current=slot/2,other=current^1u;
+  return energy[other]>9*energy[current] && energy[other]>frames*1024u?other*2+(slot&1u):slot;
+}
+static inline unsigned box_tdm_microphone_slot(unsigned microphone,unsigned reference,unsigned origin)
+{return reference<=3&&origin<=3&&((reference^origin)&1u)==0?microphone^(reference^origin):microphone;}
+#endif
diff --git a/arch/xtensa/src/esp32s3/hal_i2s_reference.h b/arch/xtensa/src/esp32s3/hal_i2s_reference.h
new file mode 100644
--- /dev/null
+++ b/arch/xtensa/src/esp32s3/hal_i2s_reference.h
@@ -0,0 +1,39 @@
+/* CPU-only playback timeline. The caller serializes reads/writes. */
+#ifndef HAL_I2S_REFERENCE_H
+#define HAL_I2S_REFERENCE_H
+#include <stdint.h>
+#include <string.h>
+#define HAL_REF_SAMPLES 65536u
+#define HAL_REF_BLOCKS (HAL_REF_SAMPLES / 64u)
+struct hal_ref_ring
+{
+  int16_t pcm[HAL_REF_SAMPLES];
+  uint32_t tag[HAL_REF_BLOCKS];
+  uint64_t valid[HAL_REF_BLOCKS];
+};
+/* RX completes in blocks. Use the CPU cycle counter to interpolate the
+ * frame position at TX enqueue; a block-rounded anchor jitters by 21ms
+ * whenever a stream under-runs and restarts. Unsigned delta handles wrap. */
+static inline uint32_t hal_ref_anchor(uint32_t frames,uint32_t last_cycle,
+                                      uint32_t now_cycle,uint32_t cpu_hz)
+{
+  uint32_t delta=now_cycle-last_cycle;
+  if(!frames || !cpu_hz || delta>cpu_hz/4)return frames;
+  return frames+(uint32_t)(((uint64_t)delta*24000u)/cpu_hz);
+}
+static inline void hal_ref_put(struct hal_ref_ring *r,uint32_t t,int16_t value)
+{
+  uint32_t block=t>>6,b=block&(HAL_REF_BLOCKS-1u);
+  if(r->tag[b]!=block){r->tag[b]=block;r->valid[b]=0;}
+  r->pcm[t&(HAL_REF_SAMPLES-1u)]=value;
+  r->valid[b]|=UINT64_C(1)<<(t&63u);
+}
+static inline int16_t hal_ref_take(struct hal_ref_ring *r,uint32_t t)
+{
+  uint32_t block=t>>6,b=block&(HAL_REF_BLOCKS-1u);
+  uint64_t bit=UINT64_C(1)<<(t&63u);
+  if(!r || r->tag[b]!=block || !(r->valid[b]&bit))return 0;
+  r->valid[b]&=~bit;
+  return r->pcm[t&(HAL_REF_SAMPLES-1u)];
+}
+#endif
