+/* RX continuity diagnostic, off by default. These counters do not alter
+ * queues, descriptors, sample selection or clock configuration. An empty-next
+ * event can include intentional draining before TX; interpret bounded RX-only
+ * windows separately from whole-boot totals. No ISR printing/allocation. */
+#ifdef I2S_HAVE_RX
+static bool s_rxdiag_enabled,s_rxdiag_waiting;
+static uint32_t s_rxdiag_starts,s_rxdiag_eofs,s_rxdiag_empty,s_rxdiag_resumes;
+static uint32_t s_rxdiag_completed,s_rxdiag_partial,s_rxdiag_unaligned;
+static uint32_t s_rxdiag_bad_eof,s_rxdiag_gap_max;
+static clock_t s_rxdiag_empty_tick;
+
+void esp32s3_i2s_rx_diag_trace(bool enabled)
+{
+  irqstate_t flags=enter_critical_section();
+  s_rxdiag_enabled=enabled;
+  if(enabled)
+    {
+      s_rxdiag_waiting=false;s_rxdiag_starts=0;s_rxdiag_eofs=0;
+      s_rxdiag_empty=0;s_rxdiag_resumes=0;s_rxdiag_completed=0;
+      s_rxdiag_partial=0;s_rxdiag_unaligned=0;s_rxdiag_bad_eof=0;
+      s_rxdiag_gap_max=0;s_rxdiag_empty_tick=0;
+    }
+  leave_critical_section(flags);
+}
+
+static void i2s_rx_diag_started(void)
+{
+  irqstate_t flags=enter_critical_section();
+  if(s_rxdiag_enabled)
+    {
+      s_rxdiag_starts++;
+      if(s_rxdiag_waiting)
+        {
+          uint32_t gap=(uint32_t)(clock_systime_ticks()-s_rxdiag_empty_tick);
+          s_rxdiag_resumes++;
+          if(gap>s_rxdiag_gap_max)s_rxdiag_gap_max=gap;
+          s_rxdiag_waiting=false;
+        }
+    }
+  leave_critical_section(flags);
+}
+
+static void i2s_rx_diag_eof(bool next)
+{
+  irqstate_t flags=enter_critical_section();
+  if(s_rxdiag_enabled)
+    {
+      s_rxdiag_eofs++;
+      if(!next)
+        {
+          s_rxdiag_empty++;s_rxdiag_waiting=true;
+          s_rxdiag_empty_tick=clock_systime_ticks();
+        }
+    }
+  leave_critical_section(flags);
+}
+
+static void i2s_rx_diag_block(uint32_t actual,uint32_t expected)
+{
+  irqstate_t flags=enter_critical_section();
+  if(s_rxdiag_enabled)
+    {
+      s_rxdiag_completed++;
+      if(actual!=expected)s_rxdiag_partial++;
+      if(actual%4)s_rxdiag_unaligned++; /* This board uses stereo16. */
+    }
+  leave_critical_section(flags);
+}
+
+static void i2s_rx_diag_unmatched(void)
+{
+  irqstate_t flags=enter_critical_section();
+  if(s_rxdiag_enabled)s_rxdiag_bad_eof++;
+  leave_critical_section(flags);
+}
+
+void esp32s3_i2s_rx_diag_dump(void)
+{
+  irqstate_t flags=enter_critical_section();
+  bool enabled=s_rxdiag_enabled,waiting=s_rxdiag_waiting;
+  uint32_t starts=s_rxdiag_starts,eofs=s_rxdiag_eofs,empty=s_rxdiag_empty;
+  uint32_t resumes=s_rxdiag_resumes,completed=s_rxdiag_completed;
+  uint32_t partial=s_rxdiag_partial,unaligned=s_rxdiag_unaligned;
+  uint32_t bad=s_rxdiag_bad_eof,gap=s_rxdiag_gap_max;
+  leave_critical_section(flags);
+  printf("[RXQueue] enabled=%d starts=%u eofs=%u empty_next=%u resumes=%u completed=%u partial=%u unaligned=%u unmatched=%u waiting=%d max_gap_ticks=%u tick_hz=%u\n",
+         enabled,starts,eofs,empty,resumes,completed,partial,unaligned,bad,
+         waiting,gap,(unsigned)TICK_PER_SEC);
+}
+#endif
