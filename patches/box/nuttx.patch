+/****************************************************************************
+ * 植小伴调试：FAT 锁递归定位包装（debug only） */
+
+static FAR void *g_fat_last_lock_ra;
+
+int plant_fat_dbg_lock(FAR struct mutex_s *m, FAR void *ra)
+{
+  if ((atomic_read(NXSEM_MHOLDER(&(m)->sem)) & NXSEM_NO_MHOLDER) ==
+      (int32_t)nxsched_gettid())
+    {
+      /* 递归加锁：把当前栈 2KB 全部打出（窗口溢出区里的返回地址
+       * 离线 addr2line 还原完整调用链，含 dump 缺口的帧）。 */
+
+      FAR const uint32_t *sp =
+        (FAR const uint32_t *)((uintptr_t)__builtin_frame_address(0) &
+                               ~(uintptr_t)0xf);
+      int k;
+
+      _alert("FAT-RECURSE cur_ra=%p outer_ra=%p sp=%p\n",
+             ra, g_fat_last_lock_ra, (FAR const void *)sp);
+
+      for (k = 0; k < 512; k += 8)
+        {
+          _alert("FATSTK %08lx: %08lx %08lx %08lx %08lx "
+                 "%08lx %08lx %08lx %08lx\n",
+                 (unsigned long)(uintptr_t)&sp[k],
+                 (unsigned long)sp[k], (unsigned long)sp[k + 1],
+                 (unsigned long)sp[k + 2], (unsigned long)sp[k + 3],
+                 (unsigned long)sp[k + 4], (unsigned long)sp[k + 5],
+                 (unsigned long)sp[k + 6], (unsigned long)sp[k + 7]);
+        }
+    }
+
+  g_fat_last_lock_ra = ra;
+  return (nxmutex_lock)(m);
+}
+
+int plant_fat_dbg_unlock(FAR struct mutex_s *m, FAR void *ra)
+{
+  g_fat_last_lock_ra = NULL;
+  return (nxmutex_unlock)(m);
+}
+
