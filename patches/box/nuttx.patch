 /****************************************************************************
+ * Name:  ili9341_putarea
+ *
+ * Description:
+ *   Write a rectangular area to the LCD.  The controller accepts one
+ *   address window followed by a continuous pixel stream, so avoid the
+ *   legacy putarea fallback that repeats window setup and SPI select for
+ *   every row.
+ *
+ ****************************************************************************/
+
+static int ili9341_putarea(FAR struct lcd_dev_s *lcd_dev,
+                           fb_coord_t row_start, fb_coord_t row_end,
+                           fb_coord_t col_start, fb_coord_t col_end,
+                           FAR const uint8_t *buffer, fb_coord_t stride)
+{
+  FAR struct ili9341_dev_s *dev = (FAR struct ili9341_dev_s *)lcd_dev;
+  FAR struct ili9341_lcd_s *lcd;
+  size_t cols;
+  size_t row_bytes;
+  size_t row_stride;
+  size_t rows;
+  bool preswapped;
+
+  if (dev == NULL || dev->lcd == NULL || buffer == NULL ||
+      row_start < 0 || row_end < row_start || col_start < 0 ||
+      col_end < col_start ||
+      row_end >= ili9341_getyres(dev) ||
+      col_end >= ili9341_getxres(dev))
+    {
+      return -EINVAL;
+    }
+
+  lcd = dev->lcd;
+  cols = (size_t)(col_end - col_start + 1);
+  rows = (size_t)(row_end - row_start + 1);
+  row_bytes = cols * sizeof(uint16_t);
+  row_stride = (size_t)((uint16_t)stride & LCDDEV_AREA_STRIDE_MASK);
+  preswapped = (((uint16_t)stride & LCDDEV_AREA_SWAPPED) != 0);
+  if (row_stride == 0)
+    {
+      row_stride = row_bytes;
+    }
+
+  if (row_stride < row_bytes)
+    {
+      return -EINVAL;
+    }
+
+  lcd->select(lcd);
+  ili9341_selectarea(lcd, col_start, row_start, col_end, row_end);
+  lcd->sendcmd(lcd, ILI9341_MEMORY_WRITE);
+
+  if (row_stride == row_bytes)
+    {
+      if (preswapped && lcd->sendgram_raw != NULL)
+        {
+          lcd->sendgram_raw(lcd, (FAR const uint16_t *)buffer, cols * rows);
+        }
+      else
+        {
+          lcd->sendgram(lcd, (FAR const uint16_t *)buffer, cols * rows);
+        }
+    }
+  else
+    {
+      size_t row;
+
+      for (row = 0; row < rows; row++)
+        {
+          FAR const uint16_t *src =
+            (FAR const uint16_t *)(buffer + row * row_stride);
+
+          if (preswapped && lcd->sendgram_raw != NULL)
+            {
+              lcd->sendgram_raw(lcd, src, cols);
+            }
+          else
+            {
+              lcd->sendgram(lcd, src, cols);
+            }
+        }
+    }
+
+  lcd->deselect(lcd);
+  return OK;
+}
