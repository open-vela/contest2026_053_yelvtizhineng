+/* Dedicated LEDC timer3/channel7, XTAL 40MHz / (19.53125 * 1024) = 2kHz.
+ * Never reset LEDC or touch timer0/channel0: those own the camera XCLK. */
+int board_box_backlight(int percent)
+{
+ static bool ready;
+ if(percent<0||percent>100)return -EINVAL;
+ if(!ready){
+   modifyreg32(SYSTEM_CLK_EN0,0,LEDC_CLK_BIT);
+   modifyreg32(SYSTEM_RST_EN0,LEDC_CLK_BIT,0);
+   modifyreg32(LEDC_CONF,3u,3u|LEDC_CLK_EN);
+   putreg32(10u|(5000u<<4),DR_REG_LEDC_BASE+0xb8);
+   modifyreg32(DR_REG_LEDC_BASE+0xb8,0,LEDC_TIMER_PARA_UP);
+   putreg32(0,DR_REG_LEDC_BASE+0x90);
+   ready=true;
+ }
+ if(percent==0||percent==100){
+   esp32s3_gpio_matrix_out(DISPLAY_BCKL,256,0,0);
+   esp32s3_gpiowrite(DISPLAY_BCKL,percent!=0);
+ }else{
+   putreg32(3u|LEDC_SIG_OUT_EN,DR_REG_LEDC_BASE+0x8c);
+   putreg32(((1024u*(unsigned)percent)/100u)<<4,DR_REG_LEDC_BASE+0x94);
+   modifyreg32(DR_REG_LEDC_BASE+0x8c,0,LEDC_CH_PARA_UP);
+   putreg32(1u<<31,DR_REG_LEDC_BASE+0x98);
+   esp32s3_gpio_matrix_out(DISPLAY_BCKL,80,0,0);
+ }
+ return 0;
+}
+
+/* Only the power amp is gated; ADC, codec and I2S microphone clocks stay on. */
+void board_box_amplifier(bool enabled)
+{
+ static bool current=true;static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+ pthread_mutex_lock(&lock);
+ if(current==enabled){pthread_mutex_unlock(&lock);return;}
+ esp32s3_gpiowrite(46,enabled);current=enabled;
+ if(enabled)nxsig_usleep(10000);
+ pthread_mutex_unlock(&lock);
+}
+
+/* GPIO_OUT1_REG=DR_REG_GPIO_BASE+0x10. Input buffers are disabled. */
+void board_box_power_status(void)
+{
+ printf("[PowerHW] backlight_gpio_latch=%d amp_gpio_latch=%d timer0=%08" PRIx32 " timer3=%08" PRIx32 " duty7=%08" PRIx32 "\n",
+        (int)((getreg32(0x60004010u)>>(DISPLAY_BCKL-32))&1u),(int)((getreg32(0x60004010u)>>(46-32))&1u),
+        getreg32(LEDC_TIMER0_CONF),getreg32(DR_REG_LEDC_BASE+0xb8),getreg32(DR_REG_LEDC_BASE+0x94));
+}
