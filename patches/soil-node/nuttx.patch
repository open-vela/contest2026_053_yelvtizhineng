diff --git a/arch/xtensa/src/esp32/esp32_wifi_adapter.c b/arch/xtensa/src/esp32/esp32_wifi_adapter.c
--- a/arch/xtensa/src/esp32/esp32_wifi_adapter.c
+++ b/arch/xtensa/src/esp32/esp32_wifi_adapter.c
@@ -5952,6 +5952,29 @@
       goto errout;
     }
 
+  /* Seed the cached AP configuration synchronously.  The AP_START event
+   * runs asynchronously, so an immediate ESSID ioctl must not copy the
+   * zero-initialized cache and set max_connection to zero.
+   */
+
+  ret = esp_wifi_get_config(WIFI_IF_AP, &g_softap_wifi_cfg);
+  if (ret)
+    {
+      ret = wifi_errno_trans(ret);
+      goto errout;
+    }
+
+  if (g_softap_wifi_cfg.ap.max_connection == 0)
+    {
+      g_softap_wifi_cfg.ap.max_connection = 4;
+      ret = esp_wifi_set_config(WIFI_IF_AP, &g_softap_wifi_cfg);
+      if (ret)
+        {
+          ret = wifi_errno_trans(ret);
+          goto errout;
+        }
+    }
+
   ret = esp_wifi_start();
   if (ret)
     {
