############################################################################
# boards/xtensa/esp32s3/m5stack-cores3/src/Make.defs
############################################################################

include $(TOPDIR)/Make.defs

CSRCS = esp32s3_boot.c esp32s3_bringup.c esp32s3_board_cores3.c

ifeq ($(CONFIG_BOARDCTL),y)
CSRCS += esp32s3_appinit.c
ifeq ($(CONFIG_BOARDCTL_RESET),y)
CSRCS += esp32s3_reset.c
endif
endif

ifeq ($(CONFIG_ARCH_BUTTONS),y)
CSRCS += esp32s3_buttons.c
endif

ifeq ($(CONFIG_ESP32S3_SPI),y)
CSRCS += esp32s3_board_spi.c
endif

ifeq ($(CONFIG_ESP32S3_CORES3_LCD),y)
CSRCS += esp32s3_board_lcd_ili9342e.c
endif

ifeq ($(CONFIG_PLANT_CAMERA_CAPTURE),y)
CSRCS += esp32s3_board_camera.c
endif

ifeq ($(CONFIG_ESP32S3_BOARD_TOUCHSCREEN),y)
CSRCS += esp32s3_board_touch_ft6336.c
endif

ifeq ($(CONFIG_MMCSD_SPI),y)
CSRCS += esp32s3_board_sdspi.c
endif

DEPPATH += --dep-path board
VPATH += :board
VPATH += :$(TOPDIR)$(DELIM)boards$(DELIM)xtensa$(DELIM)$(CONFIG_ARCH)$(DELIM)common$(DELIM)src
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)boards$(DELIM)xtensa$(DELIM)$(CONFIG_ARCH)$(DELIM)common$(DELIM)include
