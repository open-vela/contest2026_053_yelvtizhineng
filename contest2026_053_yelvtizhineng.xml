<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    植小伴（队伍 053 · 叶绿体智能）专属仓 manifest。
    include 官方 openvela 全量工程清单，再把自己仓的作品目录通过 <linkfile>
    软链到 openvela 编译树里该在的位置（只在工作区本地生效，不改动公共仓库）。
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_053_yelvtizhineng" name="contest2026_053_yelvtizhineng">
    <!--
      植小伴嵌入式端是标准 NuttX 应用：
        · 其 Make.defs 用 $(APPDIR)/plant-companion 注册（APPDIR = apps/）
        · 板级配置 esp32s3-box:openvela 用 CONFIG_PLANT_COMPANION=y 打开
      因此映射到 apps/plant-companion，clone 后无需改动任何路径即可编译。
    -->
    <linkfile src="app/plant-companion" dest="apps/plant-companion"/>
    <linkfile src="board/box/configs/contest_v239" dest="nuttx/boards/xtensa/esp32s3/esp32s3-box/configs/contest_v239"/>
    <!-- Wireless soil node: independent ESP32-WROOM-32E target. -->
    <linkfile src="app/soil-node" dest="apps/soil-node"/>
    <linkfile src="board/soil-node/configs/soilnode" dest="nuttx/boards/xtensa/esp32/esp32-devkitc/configs/soilnode"/>
  </project>
</manifest>
